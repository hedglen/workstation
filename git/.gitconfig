[user]
    name = Rob Hedglen
    email = 108037230+hedglen@users.noreply.github.com
[core]
    autocrlf = input
    editor = zed --wait
[init]
    defaultBranch = main
[pull]
    rebase = false
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[merge]
    conflictStyle = diff3
[color]
    ui = auto
[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD --stat
